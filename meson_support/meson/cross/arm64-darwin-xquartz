[constants]
staging_dir = '@DIRNAME@/../../../products/Xquartz.dest'

[host_machine]
system = 'darwin'
cpu_family = 'aarch64'
cpu = 'arm64'
endian = 'little'

[properties]
ipc_rmid_deferred_release = 'false'
sys_root = staging_dir

[binaries]
pkg-config = '/opt/buildX11/bin/pkg-config'
cmake = '/opt/buildX11/bin/cmake'
strip = '/usr/bin/strip'
llvm-config = '/opt/buildX11-llvm/bin/llvm-config'
